# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite build output
/dist
/build

# legacy Next.js / OpenNext / Wrangler artifacts (kept ignored for safety)
/.next/
/.open-next/
/.wrangler/
/.hasil_qa/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo

# claude
.claude/

# hoppscotch (contains JWT tokens)
hoppscotch-env.json
hoppscotch-collection.json
*.7z

# local dev notes & debug output (tidak perlu di-track)
CATATAN-API.md
build_errors.txt
typescript_errors.txt
*.pdf

# Claude Code project instructions (local only)
CLAUDE.md
